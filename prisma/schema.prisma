datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model MerchantConfig {
  id             String   @id @default(cuid())
  shop           String   @unique
  lucidNumber    String   @default("")
  dualSystemCode String   @default("INTERSEROH")
  citeoIdu       String   @default("")
  planTier       String   @default("FREE") // FREE, STARTER_14, EU_PRO_39
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BoxPreset {
  id             String   @id @default(cuid())
  shop           String
  name           String
  cardboardGrams Int      @default(165)
  plasticGrams   Int      @default(8)
  otherGrams     Int      @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([shop])
}

model OrderPackagingLog {
  id             String   @id @default(cuid())
  shop           String
  shopifyOrderId String
  orderName      String
  orderDate      String
  countryCode    String
  presetId       String
  cardboardGrams Int
  plasticGrams   Int
  otherGrams     Int

  @@unique([shop, shopifyOrderId])
  @@index([shop, countryCode])
}
