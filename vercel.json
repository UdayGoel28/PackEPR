{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/webhook/payment",
      "destination": "/api/webhook/payment.js"
    },
    {
      "source": "/api/leads",
      "destination": "/api/leads.js"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/demo",
      "destination": "/app/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/payment",
      "destination": "/payment/index.html"
    },
    {
      "source": "/success",
      "destination": "/success/index.html"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/:match*",
      "destination": "/index.html"
    }
  ]
}
